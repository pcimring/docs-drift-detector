DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs_drift_test

# Optional: raises the GitHub API rate limit for fetching doc page source.
GITHUB_TOKEN=

# Powers this tool's own fix-drafting feature (checkapi/fix_drafter.py calls
# Claude to draft and re-verify a fix when a snippet's execution fails).
# Independent of what the doc snippet under test actually demonstrates.
ANTHROPIC_API_KEY=

# Needed because some doc snippets call OpenAI's API directly (e.g. a
# LangChain example using ChatOpenAI) — the sandbox executes that real code
# against the real SDK, so it needs a real key or the snippet fails on a
# missing credential rather than genuine drift. Not a fallback/alternative
# to ANTHROPIC_API_KEY above; the two serve different, unrelated jobs.
OPENAI_API_KEY=

RATE_LIMIT_MAX_PER_HOUR=20
